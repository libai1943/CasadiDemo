<?xml version="1.0"?>
<launch>
    <node pkg="parking_planner" type="parking_planner_node" name="parking_planner_node" output="screen">
        <rosparam command="load" file="$(find parking_planner)/config/parking_planner.yaml" ns="parking_planner"/>
        <param name="env_file" value="$(find parking_planner)/config/env.json" />
    </node>

    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find parking_planner)/config/test.rviz"/>
</launch>